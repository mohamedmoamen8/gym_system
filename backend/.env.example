# Copy this file to .env and fill in real values before running in production.

# --- Server ---
PORT=3000

# --- Auth ---
# Secret used to sign JWT tokens. CHANGE THIS in production!
JWT_SECRET=gym_jwt_secret_change_in_production

# Default owner account created on first run (change after first login)
OWNER_USERNAME=owner
OWNER_PASSWORD=gym1234

# --- WhatsApp Broadcast via OpenWA ---
# Run OpenWA separately: https://github.com/rmyndharis/OpenWA
# Then create a session in the OpenWA dashboard, scan the QR code with
# your WhatsApp, create an API key, and fill in the values below.
#
# Leave empty to run in mock mode (logs only, no real messages sent).

# URL where OpenWA is running (default port is 2785)
OPENWA_URL=http://localhost:2785

# API key created in the OpenWA dashboard (Admin → API Keys → Create)
OPENWA_API_KEY=gym-system

# Session name/id you created in OpenWA (e.g. "gym")
OPENWA_SESSION=gym
OPENWA_SESSION_ID=gym-system